{
  "name": "alpha-omega",
  "version": "0.0.0",
  "private": true,
  "description": "App Alpha & Omega Training",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "prepare": "npm run build:shared && prisma generate",
    "build:shared": "npm run build --workspace packages/shared",
    "typecheck": "npm run build:shared && tsc -p tsconfig.json && npm run typecheck --workspaces --if-present",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "npm run build:shared && npm run test --workspaces --if-present",
    "test:e2e": "npm run build:shared && npm run test:e2e --workspaces --if-present",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "db:seed": "npm run seed --workspace apps/api"
  },
  "overrides": {
    "multer": "^2.3.0",
    "react-native": "0.86.3",
    "@react-native/virtualized-lists": "0.86.3",
    "@react-native/community-cli-plugin": "0.86.3",
    "@react-native/metro-config": "0.86.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native-reanimated": "4.5.1",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "prisma": "^7.10.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0"
  },
  "engines": {
    "node": ">=22"
  }
}

{
  "expo": {
    "name": "Alpha & Omega",
    "slug": "alpha-omega",
    "version": "0.0.0",
    "scheme": "alphaomega",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0A0A",
          "image": "./assets/splash/vacio.png",
          "imageWidth": 48
        }
      ]
    ],
    "ios": {
      "bundleIdentifier": "com.alphaomegatraining.app",
      "supportsTablet": false
    },
    "android": {
      "package": "com.alphaomegatraining.app",
      "edgeToEdgeEnabled": true
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}

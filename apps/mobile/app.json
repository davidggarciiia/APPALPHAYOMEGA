{
  "expo": {
    "name": "Alpha & Omega",
    "slug": "alpha-omega",
    "version": "0.0.0",
    "scheme": "alphaomega",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-video",
      [
        "expo-image-picker",
        {
          "photosPermission": "Alpha & Omega usa tus fotos solo para enviar a tu entrenador las fotos de evolución que te pida. Quedan privadas.",
          "cameraPermission": "Alpha & Omega usa la cámara solo para las fotos de evolución que te pida tu entrenador. Quedan privadas.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/video/logo-carga.png",
          "imageWidth": 288,
          "resizeMode": "contain",
          "backgroundColor": "#0E0D0B"
        }
      ]
    ],
    "ios": {
      "bundleIdentifier": "com.alphaomegatraining.app",
      "associatedDomains": ["applinks:alphayomegatraining.com"],
      "supportsTablet": false
    },
    "android": {
      "package": "com.alphaomegatraining.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "category": ["BROWSABLE", "DEFAULT"],
          "data": [
            { "scheme": "https", "host": "alphayomegatraining.com", "pathPrefix": "/activar" },
            { "scheme": "https", "host": "alphayomegatraining.com", "pathPrefix": "/restablecer" }
          ]
        }
      ]
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}

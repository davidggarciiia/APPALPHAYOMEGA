# Plantilla de la app movil. Copia a .env y ajusta.
#
#   cp .env.example .env
#
# En un emulador de Android usa http://10.0.2.2:3000
# En un movil fisico usa la IP de tu ordenador en la wifi, por ejemplo
# http://192.168.1.42:3000. "localhost" ahi apunta al propio telefono y no
# encuentra nada.

EXPO_PUBLIC_API_URL=http://localhost:3000

{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    // Expo trae su propia base. Volvemos a exigir aqui el nivel de rigor que
    // fija SPEC.md, porque su base no lo garantiza.
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    // TypeScript 6 ya no incluye tipos globales por defecto. Los de Jest hacen
    // falta para los *.spec.ts(x), que viven junto al codigo en src/.
    "types": ["jest"]
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  "exclude": ["node_modules"]
}

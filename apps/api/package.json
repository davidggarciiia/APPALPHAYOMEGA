{
  "name": "@alpha-omega/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "nest start --watch",
    "test": "node test/ejecutar-jest.mjs --config jest.config.mjs",
    "test:e2e": "node test/ejecutar-jest.mjs --config test/jest-e2e.json --runInBand",
    "test:cobertura": "node test/cobertura.mjs",
    "build": "tsc -p tsconfig.build.json",
    "seed": "npm run build && node dist/seed.js"
  },
  "dependencies": {
    "@alpha-omega/shared": "*",
    "@aws-sdk/client-s3": "^3.1139.0",
    "@aws-sdk/s3-request-presigner": "^3.1139.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/jwt": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@node-rs/argon2": "^2.2.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.28.0",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/jest": "^30.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.1",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2"
  }
}

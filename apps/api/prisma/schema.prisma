// Esquema de datos. Ninguna tabla se toca a mano: todo cambio pasa por una
// migracion versionada con `npx prisma migrate dev --name <nombre>`.

generator client {
  provider = "prisma-client-js"
}

// La URL de conexion vive en prisma.config.ts, en la raiz del monorepo.
// Desde Prisma 7 el esquema no la admite.
datasource db {
  provider = "postgresql"
}

/// Los cuatro perfiles de SPEC-identity.md. Enumerado, no texto libre: anadir un
/// quinto rol exige una migracion, que es exactamente lo que queremos.
enum Rol {
  cliente
  entrenador
  nutricionista
  empleado
}

/// Existir y poder entrar son dos cosas distintas (requisito 2).
/// - pendiente: el entrenador lo creo. Existe, recibe entrenos, no inicia sesion.
/// - activo: completo la activacion y entra con normalidad.
/// - desactivado: no entra, y su historico se conserva intacto.
enum EstadoUsuario {
  pendiente
  activo
  desactivado
}

enum SexoUsuario {
  hombre
  mujer
}

model Usuario {
  id String @id @default(uuid())

  email String @unique

  /// Opcional a proposito: un usuario pendiente todavia no tiene contrasena.
  /// Se guarda con Argon2id y no sale del servidor en ninguna respuesta.
  passwordHash String?

  nombre    String
  apellidos String?

  /// Datos de contacto del perfil. Todos opcionales: un perfil recien creado por
  /// el entrenador solo tiene nombre y correo, y su titular los completa despues.
  telefono        String?
  fechaNacimiento DateTime?
  sexo            SexoUsuario?
  fotoUrl         String?

  rol    Rol
  estado EstadoUsuario @default(pendiente)

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  tokensRefresco     TokenRefresco[]
  tokensActivacion   TokenActivacion[]
  tokensRecuperacion TokenRecuperacion[]

  /// Clientes que este usuario ve como nutricionista.
  clientesAsignados AsignacionNutricionista[] @relation("ComoNutricionista")

  /// Nutricionistas que ven a este usuario como cliente.
  nutricionistasAsignados AsignacionNutricionista[] @relation("ComoCliente")

  planesRecibidos     PlanEntrenamiento[] @relation("ClientePlan")
  planesCreados       PlanEntrenamiento[] @relation("CreadorPlan")
  sesionesProgramadas SesionProgramada[]
  cambiosDeFecha      CambioDeFecha[]
  rutinasGuardadas    RutinaGuardada[]

  dietas           Dieta[] @relation("DietasCliente")
  dietasCreadas    Dieta[] @relation("DietasCreadas")
  dietasPublicadas Dieta[] @relation("DietasPublicadas")

  molestias                Molestia[]                 @relation("MolestiasCliente")
  molestiasAtendidas       Molestia[]                 @relation("MolestiasAtendidas")
  diasSeguimiento          DiaSeguimiento[]
  medidas                  MedidaCorporal[]           @relation("MedidasCliente")
  medidasTomadas           MedidaCorporal[]           @relation("MedidasAutor")
  pruebas                  PruebaFisica[]             @relation("PruebasCliente")
  pruebasTomadas           PruebaFisica[]             @relation("PruebasAutor")
  configuracionSeguimiento ConfiguracionSeguimiento?
  comidasRegistradas       ComidaRegistrada[]
  comentariosSesion        ComentarioSesion[]         @relation("ComentariosCliente")
  comentariosEscritos      ComentarioSesion[]         @relation("ComentariosAutor")
  sesionesRevisadas        SesionEntrenamiento[]      @relation("RevisionesEntrenamiento")
  novedadesCreadas         NovedadEntrenamiento[]     @relation("AutoresNovedadEntrenamiento")
  lecturasNovedades        LecturaNovedad[]
  plantillaValoracion      PlantillaValoracion?
  valoraciones             Valoracion[]               @relation("ValoracionesCliente")
  valoracionesCreadas      Valoracion[]               @relation("ValoracionesAutor")
  borradoresValoracion     BorradorValoracion[]
  publicacionesValoracion  PublicacionValoracion[]
  operacionesValoracion    OperacionValoracion[]
  proximaRevision          ProximaRevisionValoracion?
  lecturasAvisos           LecturaAvisoSeguimiento[]
  fotos                    MedioFoto[]                @relation("FotosCliente")
  fotosAportadas           MedioFoto[]                @relation("FotosAutor")
  solicitudesFotos         SolicitudFotos[]           @relation("SolicitudesFotosCliente")
  solicitudesFotosCreadas  SolicitudFotos[]           @relation("SolicitudesFotosAutor")
  consentimientosSalud     ConsentimientoSalud[]

  movimientosBono            MovimientoBono[]   @relation("MovimientosBonoCliente")
  movimientosBonoCreados     MovimientoBono[]   @relation("MovimientosBonoAutor")
  seguimientoBonos           SeguimientoBonos?  @relation("SeguimientoBonosCliente")
  seguimientosBonosCambiados SeguimientoBonos[] @relation("SeguimientoBonosAutor")

  @@map("usuarios")
}

enum ServicioReserva {
  entrenoPersonal
  seguimiento
  quiromasaje
}

enum TipoMovimientoBono {
  carga
  consumo
  devolucion
  ajuste
}

/// El bono es su carga; el saldo siempre se calcula sumando movimientos.
model MovimientoBono {
  id          String             @id @default(uuid())
  clienteId   String
  autorId     String
  operacionId String             @default(uuid())
  servicio    ServicioReserva
  tipo        TipoMovimientoBono
  cantidad    Int
  mes         String?            @db.VarChar(7)
  nota        String?
  creadoEn    DateTime           @default(now())
  cliente     Usuario            @relation("MovimientosBonoCliente", fields: [clienteId], references: [id], onDelete: Restrict)
  autor       Usuario            @relation("MovimientosBonoAutor", fields: [autorId], references: [id], onDelete: Restrict)

  @@unique([autorId, operacionId])
  @@index([clienteId, servicio, mes])
  @@index([clienteId, creadoEn, id])
  @@map("movimientos_bono")
}

model SeguimientoBonos {
  clienteId     String   @id
  activo        Boolean  @default(false)
  autorId       String
  actualizadoEn DateTime @updatedAt
  cliente       Usuario  @relation("SeguimientoBonosCliente", fields: [clienteId], references: [id], onDelete: Restrict)
  autor         Usuario  @relation("SeguimientoBonosAutor", fields: [autorId], references: [id], onDelete: Restrict)

  @@map("seguimiento_bonos")
}

/// Token de refresco: la pieza que permite que el cliente no vuelva a escribir
/// su contrasena cada quince minutos.
///
/// Se guarda el hash, nunca el token. Quien robe una copia de la base de datos
/// no obtiene sesiones utilizables. Basta SHA-256 y no hace falta Argon2 porque
/// el secreto lo genera el servidor con 32 bytes aleatorios: no hay diccionario
/// que probar, y Argon2 solo serviria para hacer lento cada refresco legitimo.
model TokenRefresco {
  id String @id @default(uuid())

  usuarioId String
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  /// SHA-256 del secreto. El token que ve el cliente es "<id>.<secreto>".
  hash String

  /// Identifica la cadena entera de tokens nacida de un mismo login.
  ///
  /// Cada rotacion crea una fila nueva pero conserva esta familia. Sirve para
  /// dos cosas: cortar todas las sesiones derivadas de un login cuando se
  /// detecta que un token ya usado vuelve a aparecer, y aplicar una vida maxima
  /// a la cadena para que rotar no la alargue indefinidamente.
  familiaId       String
  familiaCreadaEn DateTime

  expiraEn   DateTime
  revocadoEn DateTime?
  creadoEn   DateTime  @default(now())

  /// Por que se revoco. No es documentacion: decide si un token que reaparece
  /// merece indulgencia. Una rotacion cuya respuesta se perdio si; un cierre de
  /// sesion o una expulsion, jamas.
  motivoRevocacion MotivoRevocacion?

  @@index([usuarioId])
  @@index([familiaId])
  @@map("tokens_refresco")
}

/// Que clientes puede ver cada nutricionista.
///
/// El nutricionista es un profesional EXTERNO subcontratado. Sin una fila aqui
/// no ve absolutamente nada de un cliente: ni su dieta, ni su peso, ni sus
/// medidas. El rol por si solo no basta, y esa es justo la frontera entre un
/// producto y un incidente de proteccion de datos.
model AsignacionNutricionista {
  id String @id @default(uuid())

  nutricionistaId String
  nutricionista   Usuario @relation("ComoNutricionista", fields: [nutricionistaId], references: [id], onDelete: Cascade)

  clienteId String
  cliente   Usuario @relation("ComoCliente", fields: [clienteId], references: [id], onDelete: Cascade)

  desde DateTime @default(now())

  /// Una asignacion por pareja. Asignar dos veces no crea dos filas.
  @@unique([nutricionistaId, clienteId])
  @@index([clienteId])
  @@map("asignaciones_nutricionista")
}

/// Enlace de un solo uso con el que un perfil pendiente fija su contrasena.
///
/// Mismo patron que el token de refresco: en la base solo vive el hash del
/// secreto, y lo que se envia por correo es "<id>.<secreto>". Un correo se queda
/// en servidores ajenos y en la papelera durante anos, asi que el enlace caduca
/// pronto y solo sirve una vez.
model TokenActivacion {
  id String @id @default(uuid())

  usuarioId String
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  hash String

  expiraEn DateTime
  usadoEn  DateTime?
  creadoEn DateTime  @default(now())

  @@index([usuarioId])
  @@map("tokens_activacion")
}

/// Recuperacion de una cuenta activa. Independiente de activacion: un enlace
/// de recuperacion nunca puede activar una cuenta pendiente o desactivada.
/// Solo se almacena SHA-256 del secreto aleatorio y caduca en una hora.
model TokenRecuperacion {
  id String @id @default(uuid())

  usuarioId String
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  hash     String
  expiraEn DateTime
  usadoEn  DateTime?
  creadoEn DateTime  @default(now())

  @@index([usuarioId])
  @@map("tokens_recuperacion")
}

/// Por que dejo de valer un token de refresco.
enum MotivoRevocacion {
  /// Se canjeo por otro. Es el caso normal y el unico que admite una ventana de
  /// gracia: si la respuesta no llego al movil, el cliente reintenta con el viejo.
  rotacion

  /// El usuario cerro sesion, o se expulsaron todas sus sesiones. Aqui no hay
  /// indulgencia posible: revivirlo convertiria el boton de cerrar sesion en una
  /// mentira.
  cierre

  /// Se detecto que un token ya gastado volvia a aparecer fuera de plazo.
  reuso

  /// Ya se uso su ventana de gracia. Marcarlo impide que varias peticiones
  /// simultaneas la usen todas y acaben bifurcando la sesion en varias cadenas,
  /// que es exactamente lo que la rotacion existe para impedir.
  reintento
}

/// Vocabulario compartido con packages/shared/src/catalogo-ejercicios.ts.
enum GrupoMuscular {
  pecho
  espalda
  hombros
  biceps
  triceps
  antebrazos
  abdomen
  gluteos
  cuadriceps
  isquiotibiales
  gemelos
}

enum EstadoEjercicio {
  publicado
  retirado
}

/// Catálogo global. La retirada conserva el ejercicio para su histórico.
model Ejercicio {
  id                String          @id @default(uuid())
  nombre            String          @db.VarChar(120)
  nombreNormalizado String          @unique
  grupoPrincipal    GrupoMuscular
  instrucciones     String          @db.VarChar(4000)
  /// «Cómo hacerlo» paso a paso, «evita» y consejos de la ficha de técnica (Design.html).
  pasos             Json            @default("[]")
  evita             String?         @db.VarChar(500)
  consejos          Json            @default("[]")
  estado            EstadoEjercicio @default(publicado)
  retiradoEn        DateTime?
  creadoEn          DateTime        @default(now())
  actualizadoEn     DateTime        @updatedAt

  gruposSecundarios GrupoSecundarioDeEjercicio[]
  referencias       ReferenciaEjercicio[]
  contenidos        ContenidoDeEjercicio[]

  @@index([estado, grupoPrincipal])
  @@map("ejercicios")
}

model GrupoSecundarioDeEjercicio {
  ejercicioId String
  grupo       GrupoMuscular
  ejercicio   Ejercicio     @relation(fields: [ejercicioId], references: [id], onDelete: Cascade)

  @@id([ejercicioId, grupo])
  @@index([grupo])
  @@map("grupos_secundarios_de_ejercicio")
}

enum EstadoSesionProgramada {
  abierta
  cerrada
}

model PlanEntrenamiento {
  id            String                @id @default(uuid())
  clienteId     String
  cliente       Usuario               @relation("ClientePlan", fields: [clienteId], references: [id], onDelete: Restrict)
  creadorId     String
  creador       Usuario               @relation("CreadorPlan", fields: [creadorId], references: [id], onDelete: Restrict)
  operacionId   String
  hashPeticion  String
  nombre        String                @db.VarChar(120)
  semanaInicial DateTime              @db.Date
  semanas       Int
  version       Int                   @default(1)
  patron        Json
  respuesta     Json
  /// Qué buscamos, fases, otros deportes y notas: lo que enseña «Bloque».
  bloque        Json?
  creadoEn      DateTime              @default(now())
  sesiones      SesionEntrenamiento[]

  @@unique([creadorId, operacionId])
  @@unique([id, clienteId])
  @@index([clienteId])
  @@map("planes_entrenamiento")
}

model SesionProgramada {
  id            String                 @id @default(uuid())
  clienteId     String
  cliente       Usuario                @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  fechaOriginal DateTime               @db.Date
  fechaActual   DateTime               @db.Date
  estado        EstadoSesionProgramada @default(abierta)
  revision      Int                    @default(0)
  entrenamiento SesionEntrenamiento?
  cambios       CambioDeFecha[]

  @@unique([id, clienteId])
  @@index([clienteId, fechaActual])
  @@map("sesiones_programadas")
}

model SesionEntrenamiento {
  id                   String                   @id
  clienteId            String
  agenda               SesionProgramada         @relation(fields: [id, clienteId], references: [id, clienteId], onDelete: Restrict)
  planId               String
  plan                 PlanEntrenamiento        @relation(fields: [planId, clienteId], references: [id, clienteId], onDelete: Restrict)
  version              Int                      @default(1)
  prescripcion         Json
  revisionPrescripcion Int                      @default(0)
  iniciada             Boolean                  @default(false)
  revisionBorrador     Int                      @default(0)
  borrador             Json?
  resultado            Json?
  enviadoEn            DateTime?
  revisadaEn           DateTime?
  revisadaPorId        String?
  revisadaPor          Usuario?                 @relation("RevisionesEntrenamiento", fields: [revisadaPorId], references: [id], onDelete: Restrict)
  referencias          ReferenciaEjercicio[]
  operaciones          OperacionEntrenamiento[]
  molestias            Molestia[]
  comentarios          ComentarioSesion[]
  novedades            NovedadEntrenamiento[]

  @@unique([id, clienteId])
  @@index([planId])
  @@map("sesiones_entrenamiento")
}

model ReferenciaEjercicio {
  sesionId    String
  idPrescrito String
  ejercicioId String
  sesion      SesionEntrenamiento @relation(fields: [sesionId], references: [id], onDelete: Restrict)
  ejercicio   Ejercicio           @relation(fields: [ejercicioId], references: [id], onDelete: Restrict)

  @@id([sesionId, idPrescrito])
  @@index([ejercicioId])
  @@map("referencias_ejercicio")
}

model CambioDeFecha {
  id            String           @id @default(uuid())
  sesionId      String
  sesion        SesionProgramada @relation(fields: [sesionId], references: [id], onDelete: Restrict)
  fechaAnterior DateTime         @db.Date
  fechaNueva    DateTime         @db.Date
  autorId       String
  autor         Usuario          @relation(fields: [autorId], references: [id], onDelete: Restrict)
  cambiadoEn    DateTime         @default(now())

  @@index([sesionId, cambiadoEn])
  @@map("cambios_de_fecha")
}

model RutinaGuardada {
  id            String   @id @default(uuid())
  nombre        String   @db.VarChar(120)
  creadorId     String
  creador       Usuario  @relation(fields: [creadorId], references: [id], onDelete: Restrict)
  version       Int      @default(1)
  patron        Json
  revision      Int      @default(0)
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@index([creadorId])
  @@map("rutinas_guardadas")
}

/// Registro de operaciones confirmado en la misma transacción que la escritura.
model OperacionEntrenamiento {
  sesionId     String
  sesion       SesionEntrenamiento @relation(fields: [sesionId], references: [id], onDelete: Restrict)
  operacionId  String
  tipo         String
  version      Int                 @default(1)
  hashPeticion String
  respuesta    Json
  creadoEn     DateTime            @default(now())

  @@id([sesionId, operacionId])
  @@map("operaciones_entrenamiento")
}

enum EstadoDieta {
  borrador
  publicada
  archivada
}

/// Dieta de un cliente (SPEC-nutricion.md). El documento completo va en JSON,
/// validado con Zod en cada escritura y lectura, como la prescripción.
///
/// Un cliente tiene como mucho un borrador y una publicada: lo garantizan dos
/// índices únicos parciales escritos en la migración, porque Prisma no los
/// expresa en el esquema. Una publicada o archivada no se modifica nunca.
model Dieta {
  id                   String             @id @default(uuid())
  clienteId            String
  cliente              Usuario            @relation("DietasCliente", fields: [clienteId], references: [id], onDelete: Restrict)
  estado               EstadoDieta
  /// Versión del formato del documento, para poder migrarlo sin reescribir filas.
  version              Int                @default(1)
  documento            Json
  revision             Int                @default(0)
  /// Idempotencia de la publicación: el mismo id devuelve el mismo resultado.
  operacionPublicacion String?
  hashPublicacion      String?
  creadaPorId          String
  creadaPor            Usuario            @relation("DietasCreadas", fields: [creadaPorId], references: [id], onDelete: Restrict)
  publicadaPorId       String?
  publicadaPor         Usuario?           @relation("DietasPublicadas", fields: [publicadaPorId], references: [id], onDelete: Restrict)
  creadaEn             DateTime           @default(now())
  actualizadaEn        DateTime           @updatedAt
  publicadaEn          DateTime?
  archivadaEn          DateTime?
  registros            ComidaRegistrada[]

  @@unique([clienteId, operacionPublicacion])
  @@index([clienteId, estado])
  @@map("dietas")
}

enum TipoDeContenido {
  figura
  video
}

enum OrigenDeContenido {
  propio
  licenciado
  provisional
}

/// Figura o vídeo de un ejercicio (SPEC-catalogo-ejercicios.md). La clave apunta
/// al índice de medios del servidor y nunca sale en una respuesta. Un ejercicio
/// tiene como mucho una figura y un vídeo. Ninguna columna apunta a un usuario.
model ContenidoDeEjercicio {
  id            String            @id @default(uuid())
  ejercicioId   String
  ejercicio     Ejercicio         @relation(fields: [ejercicioId], references: [id], onDelete: Restrict)
  tipo          TipoDeContenido
  claveDeObjeto String            @db.VarChar(120)
  origen        OrigenDeContenido
  licencia      String?           @db.VarChar(200)
  atribucion    String?           @db.VarChar(200)
  subidoEn      DateTime          @default(now())

  @@unique([ejercicioId, tipo])
  @@map("contenidos_de_ejercicio")
}

enum ZonaDeMolestia {
  hombro
  codo
  muneca
  lumbar
  otra
}

enum EstadoMolestia {
  abierta
  atendida
}

/// Molestia avisada durante un entrenamiento (Design.html). La intensidad va de
/// 0 a 10 (CHECK en la migración). El nombre del ejercicio se copia al avisar:
/// la prescripción puede cambiar después y el aviso tiene que seguir diciendo lo mismo.
model Molestia {
  id                   String              @id @default(uuid())
  clienteId            String
  cliente              Usuario             @relation("MolestiasCliente", fields: [clienteId], references: [id], onDelete: Restrict)
  sesionId             String
  sesion               SesionEntrenamiento @relation(fields: [sesionId, clienteId], references: [id, clienteId], onDelete: Restrict)
  operacionId          String
  ejercicioPrescritoId String?
  ejercicio            String?             @db.VarChar(120)
  serie                Int?
  zona                 ZonaDeMolestia
  intensidad           Int
  sintomas             String[]
  nota                 String?             @db.VarChar(1000)
  estado               EstadoMolestia      @default(abierta)
  respuesta            String?             @db.VarChar(1000)
  atendidaPorId        String?
  atendidaPor          Usuario?            @relation("MolestiasAtendidas", fields: [atendidaPorId], references: [id], onDelete: Restrict)
  atendidaEn           DateTime?
  creadaEn             DateTime            @default(now())

  @@unique([clienteId, operacionId])
  @@index([clienteId, estado, creadaEn])
  @@map("molestias")
}

/// Registro diario del cliente: peso en ayunas, pasos, sueño y creatina.
model DiaSeguimiento {
  clienteId     String
  cliente       Usuario  @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  fecha         DateTime @db.Date
  pesoKg        Decimal? @db.Decimal(4, 1)
  pasos         Int?
  suenoMin      Int?
  creatina      Boolean?
  suplementos   Json     @default("[]")
  actualizadoEn DateTime @updatedAt

  @@id([clienteId, fecha])
  @@map("dias_seguimiento")
}

/// Preferencias y prescripciones de seguimiento por cliente. Sin fila se usa
/// la configuración inicial del contrato compartido (revisión 0).
model ConfiguracionSeguimiento {
  clienteId     String   @id
  cliente       Usuario  @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  revision      Int      @default(1)
  documento     Json
  actualizadoEn DateTime @updatedAt

  @@map("configuraciones_seguimiento")
}

/// Medidas corporales: las toma el cliente o su equipo.
model MedidaCorporal {
  id          String   @id @default(uuid())
  clienteId   String
  cliente     Usuario  @relation("MedidasCliente", fields: [clienteId], references: [id], onDelete: Restrict)
  autorId     String
  autor       Usuario  @relation("MedidasAutor", fields: [autorId], references: [id], onDelete: Restrict)
  operacionId String
  fecha       DateTime @db.Date
  pesoKg      Decimal? @db.Decimal(4, 1)
  cinturaCm   Decimal? @db.Decimal(4, 1)
  grasaPct    Decimal? @db.Decimal(3, 1)
  alturaCm    Int?
  creadoEn    DateTime @default(now())

  @@unique([autorId, operacionId])
  @@index([clienteId, fecha])
  @@map("medidas_corporales")
}

/// Pruebas físicas: «Flexiones seguidas · 32 reps».
model PruebaFisica {
  id          String   @id @default(uuid())
  clienteId   String
  cliente     Usuario  @relation("PruebasCliente", fields: [clienteId], references: [id], onDelete: Restrict)
  autorId     String
  autor       Usuario  @relation("PruebasAutor", fields: [autorId], references: [id], onDelete: Restrict)
  operacionId String
  /// Nulo para el histórico creado antes de prescribir pruebas.
  pruebaId    String?
  fecha       DateTime @db.Date
  nombre      String   @db.VarChar(60)
  valor       Decimal  @db.Decimal(8, 2)
  unidad      String   @db.VarChar(12)
  creadoEn    DateTime @default(now())

  @@unique([autorId, operacionId])
  @@index([clienteId, nombre, fecha])
  @@index([clienteId, pruebaId, fecha])
  @@map("pruebas_fisicas")
}

/// Comida marcada como hecha por el cliente, con lo que eligió de su dieta.
model ComidaRegistrada {
  clienteId    String
  cliente      Usuario  @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  fecha        DateTime @db.Date
  comidaId     String
  dietaId      String
  dieta        Dieta    @relation(fields: [dietaId], references: [id], onDelete: Restrict)
  eleccion     Json
  registradaEn DateTime @updatedAt

  @@id([clienteId, fecha, comidaId])
  @@index([dietaId])
  @@map("comidas_registradas")
}

/// Comentario sobre una sesión enviada, o sobre uno de sus ejercicios.
model ComentarioSesion {
  id                   String              @id @default(uuid())
  sesionId             String
  clienteId            String
  sesion               SesionEntrenamiento @relation(fields: [sesionId, clienteId], references: [id, clienteId], onDelete: Restrict)
  cliente              Usuario             @relation("ComentariosCliente", fields: [clienteId], references: [id], onDelete: Restrict)
  autorId              String
  autor                Usuario             @relation("ComentariosAutor", fields: [autorId], references: [id], onDelete: Restrict)
  operacionId          String
  ejercicioPrescritoId String?
  ejercicio            String?             @db.VarChar(120)
  texto                String              @db.VarChar(2000)
  creadoEn             DateTime            @default(now())

  @@unique([autorId, operacionId])
  @@index([sesionId, creadoEn])
  @@map("comentarios_sesion")
}

/// Evento dirigido a cliente o entrenador; cada usuario registra su propia lectura.
model NovedadEntrenamiento {
  id        String              @id @default(uuid())
  sesionId  String
  clienteId String
  sesion    SesionEntrenamiento @relation(fields: [sesionId, clienteId], references: [id, clienteId], onDelete: Restrict)
  tipo      String              @db.VarChar(40)
  audiencia String              @db.VarChar(20)
  autorId   String
  autor     Usuario             @relation("AutoresNovedadEntrenamiento", fields: [autorId], references: [id], onDelete: Restrict)
  creadaEn  DateTime            @default(now())
  lecturas  LecturaNovedad[]

  @@index([clienteId, audiencia, creadaEn])
  @@index([sesionId, creadaEn])
  @@map("novedades_entrenamiento")
}

model LecturaNovedad {
  novedadId String
  usuarioId String
  novedad   NovedadEntrenamiento @relation(fields: [novedadId], references: [id], onDelete: Restrict)
  usuario   Usuario              @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  leidaEn   DateTime             @default(now())

  @@id([novedadId, usuarioId])
  @@index([usuarioId])
  @@map("lecturas_novedades")
}

/// Plantilla de valoración de un cliente: definiciones corporales y pruebas con
/// identidad y versión estables. Cada visita guarda su propia copia.
model PlantillaValoracion {
  clienteId     String   @id
  cliente       Usuario  @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  revision      Int      @default(1)
  documento     Json
  actualizadoEn DateTime @updatedAt

  @@map("plantillas_valoracion")
}

enum TipoValoracion {
  inicial
  revision
}

/// Visita de valoración. Sus borradores y versiones publicadas cuelgan de ella;
/// una corrección es otra versión de la misma visita, nunca otra visita.
model Valoracion {
  id            String                     @id @default(uuid())
  clienteId     String
  cliente       Usuario                    @relation("ValoracionesCliente", fields: [clienteId], references: [id], onDelete: Restrict)
  autorId       String
  autor         Usuario                    @relation("ValoracionesAutor", fields: [autorId], references: [id], onDelete: Restrict)
  tipo          TipoValoracion
  /// En una revisión, la visita de referencia. La inicial no tiene.
  anteriorId    String?
  anterior      Valoracion?                @relation("ValoracionAnterior", fields: [anteriorId], references: [id], onDelete: Restrict)
  siguientes    Valoracion[]               @relation("ValoracionAnterior")
  creadaEn      DateTime                   @default(now())
  borradores    BorradorValoracion[]
  publicaciones PublicacionValoracion[]
  operaciones   OperacionValoracion[]
  pautaCumplida ProximaRevisionValoracion?
  fotos         MedioFoto[]

  @@index([clienteId, creadaEn])
  @@map("valoraciones")
}

/// Documento de trabajo del entrenador. Como mucho uno abierto por visita:
/// `valoracionAbiertaId` vale el id de la visita mientras está abierto y es único;
/// al publicarse pasa a nulo y el borrador queda como auditoría.
model BorradorValoracion {
  id                   String                 @id @default(uuid())
  valoracionId         String
  valoracion           Valoracion             @relation(fields: [valoracionId], references: [id], onDelete: Restrict)
  autorId              String
  autor                Usuario                @relation(fields: [autorId], references: [id], onDelete: Restrict)
  /// Publicación vigente que sustituirá una corrección.
  corrigePublicacionId String?                @unique
  corrige              PublicacionValoracion? @relation("CorreccionDePublicacion", fields: [corrigePublicacionId], references: [id], onDelete: Restrict)
  revision             Int                    @default(1)
  fechaToma            DateTime               @db.Date
  documento            Json
  valoracionAbiertaId  String?                @unique
  creadoEn             DateTime               @default(now())
  actualizadoEn        DateTime               @updatedAt
  publicacion          PublicacionValoracion? @relation("PublicacionDeBorrador")

  @@index([valoracionId])
  @@map("borradores_valoracion")
}

/// Versión publicada e inmutable. `documento` es la proyección pública: nunca
/// contiene notas internas ni datos pendientes.
model PublicacionValoracion {
  id            String                 @id @default(uuid())
  valoracionId  String
  valoracion    Valoracion             @relation(fields: [valoracionId], references: [id], onDelete: Restrict)
  borradorId    String                 @unique
  borrador      BorradorValoracion     @relation("PublicacionDeBorrador", fields: [borradorId], references: [id], onDelete: Restrict)
  numero        Int
  sustituyeId   String?                @unique
  sustituye     PublicacionValoracion? @relation("SustitucionDePublicacion", fields: [sustituyeId], references: [id], onDelete: Restrict)
  sustituidaPor PublicacionValoracion? @relation("SustitucionDePublicacion")
  corregidaEn   BorradorValoracion?    @relation("CorreccionDePublicacion")
  fechaToma     DateTime               @db.Date
  autorId       String
  autor         Usuario                @relation(fields: [autorId], references: [id], onDelete: Restrict)
  documento     Json
  publicadaEn   DateTime               @default(now())

  @@unique([valoracionId, numero])
  @@map("publicaciones_valoracion")
}

/// Crear y publicar son idempotentes por autor y operación. La huella de la
/// petición distingue un reintento de una reutilización con otro contenido.
model OperacionValoracion {
  autorId       String
  autor         Usuario    @relation(fields: [autorId], references: [id], onDelete: Restrict)
  operacionId   String
  tipo          String     @db.VarChar(20)
  hashPeticion  String
  valoracionId  String
  valoracion    Valoracion @relation(fields: [valoracionId], references: [id], onDelete: Restrict)
  borradorId    String?
  publicacionId String?
  creadoEn      DateTime   @default(now())

  @@id([autorId, operacionId])
  @@index([valoracionId])
  @@map("operaciones_valoracion")
}

/// Próxima revisión pautada por el entrenador. `pauta` nula es «Sin programar».
/// Una visita solo puede cumplir una pauta.
model ProximaRevisionValoracion {
  clienteId     String      @id
  cliente       Usuario     @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  revision      Int         @default(1)
  pauta         Json?
  cumplidaPorId String?     @unique
  cumplidaPor   Valoracion? @relation(fields: [cumplidaPorId], references: [id], onDelete: Restrict)
  actualizadoEn DateTime    @updatedAt

  @@map("proximas_revisiones_valoracion")
}

/// Lectura por usuario de avisos de seguimiento (publicaciones, solicitudes).
/// No exige un `sesionId` de entrenamiento: el aviso se identifica por su origen.
model LecturaAvisoSeguimiento {
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  avisoId   String
  tipo      String   @db.VarChar(40)
  leidoEn   DateTime @default(now())

  @@id([usuarioId, avisoId])
  @@map("lecturas_avisos_seguimiento")
}

enum VistaFoto {
  frente
  espalda
  perfilIzquierdo
  perfilDerecho
  otra
}

enum EstadoMedio {
  pendiente
  disponible
  eliminando
  eliminado
}

enum OrigenMedio {
  profesional
  cliente
}

enum EstadoSolicitudFotos {
  pendiente
  recibida
  revisada
}

/// Foto privada de evolución (ADR 0005). `clave` es la ubicación del objeto en el
/// almacén: nunca sale en una respuesta ni se guarda una URL firmada.
model MedioFoto {
  id             String          @id @default(uuid())
  clienteId      String
  cliente        Usuario         @relation("FotosCliente", fields: [clienteId], references: [id], onDelete: Restrict)
  autorId        String
  autor          Usuario         @relation("FotosAutor", fields: [autorId], references: [id], onDelete: Restrict)
  operacionId    String
  origen         OrigenMedio
  vista          VistaFoto
  etiqueta       String?         @db.VarChar(40)
  fechaToma      DateTime        @db.Date
  estado         EstadoMedio     @default(pendiente)
  tipoMime       String          @db.VarChar(20)
  bytes          Int
  clave          String          @unique
  /// Hasta cuándo vale la intención de subida; después se limpia si sigue pendiente.
  subidaCaducaEn DateTime
  /// Visita a la que pertenece. Incorporar una aportación no cambia su autor ni su origen.
  valoracionId   String?
  valoracion     Valoracion?     @relation(fields: [valoracionId], references: [id], onDelete: Restrict)
  /// Solicitud del entrenador a la que respondió el cliente.
  solicitudId    String?
  solicitud      SolicitudFotos? @relation(fields: [solicitudId], references: [id], onDelete: Restrict)
  /// Visible para el cliente desde que se publicó la visita que la incluye.
  publicadaEn    DateTime?
  creadoEn       DateTime        @default(now())
  confirmadoEn   DateTime?
  eliminadoEn    DateTime?

  @@unique([autorId, operacionId])
  @@index([clienteId, vista, fechaToma])
  @@index([valoracionId])
  @@index([solicitudId])
  @@index([estado, subidaCaducaEn])
  @@map("medios_fotos")
}

/// Copias por intento, registradas antes de escribir al almacén. Sin FK: una
/// limpieza pendiente debe sobrevivir a la retirada de la intención original.
/// Al publicar se elimina esta fila en la misma transacción; descartar la
/// conserva para recuperar borrados fallidos o escrituras externas tardías.
model IntentoFoto {
  clave         String    @id
  medioId       String
  creadoEn      DateTime  @default(now())
  descartadoEn  DateTime?
  reintentarEn  DateTime

  @@index([reintentarEn, clave])
  @@index([medioId])
  @@map("intentos_foto")
}

/// Fotos que el entrenador pide al cliente. Recibirlas no las marca revisadas.
model SolicitudFotos {
  id                  String               @id @default(uuid())
  clienteId           String
  cliente             Usuario              @relation("SolicitudesFotosCliente", fields: [clienteId], references: [id], onDelete: Restrict)
  autorId             String
  autor               Usuario              @relation("SolicitudesFotosAutor", fields: [autorId], references: [id], onDelete: Restrict)
  operacionId         String
  vistas              VistaFoto[]
  fechaLimite         DateTime?            @db.Date
  mensaje             String?              @db.VarChar(200)
  estado              EstadoSolicitudFotos @default(pendiente)
  creadaEn            DateTime             @default(now())
  recibidaEn          DateTime?
  revisadaEn          DateTime?
  revisionOperacionId String?
  medios              MedioFoto[]

  @@unique([autorId, operacionId])
  @@index([clienteId, creadaEn])
  @@map("solicitudes_fotos")
}

/// Consentimiento explícito del cliente para tratar sus datos de salud (RGPD,
/// art. 9). Una fila por versión aceptada del texto; retirarlo no borra la fila.
model ConsentimientoSalud {
  id         String    @id @default(uuid())
  usuarioId  String
  usuario    Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  version    String    @db.VarChar(40)
  aceptadoEn DateTime  @default(now())
  retiradoEn DateTime?

  @@unique([usuarioId, version])
  @@map("consentimientos_salud")
}

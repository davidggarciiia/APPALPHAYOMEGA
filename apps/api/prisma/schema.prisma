// Esquema de datos. Ninguna tabla se toca a mano: todo cambio pasa por una
// migracion versionada con `npx prisma migrate dev --name <nombre>`.

generator client {
  provider = "prisma-client-js"
}

// La URL de conexion vive en prisma.config.ts, en la raiz del monorepo.
// Desde Prisma 7 el esquema no la admite.
datasource db {
  provider = "postgresql"
}

/// Los cuatro perfiles de SPEC-identity.md. Enumerado, no texto libre: anadir un
/// quinto rol exige una migracion, que es exactamente lo que queremos.
enum Rol {
  cliente
  entrenador
  nutricionista
  empleado
}

/// Existir y poder entrar son dos cosas distintas (requisito 2).
/// - pendiente: el entrenador lo creo. Existe, recibe entrenos, no inicia sesion.
/// - activo: completo la activacion y entra con normalidad.
/// - desactivado: no entra, y su historico se conserva intacto.
enum EstadoUsuario {
  pendiente
  activo
  desactivado
}

model Usuario {
  id String @id @default(uuid())

  email String @unique

  /// Opcional a proposito: un usuario pendiente todavia no tiene contrasena.
  /// Se guarda con Argon2id y no sale del servidor en ninguna respuesta.
  passwordHash String?

  nombre    String
  apellidos String?

  /// Datos de contacto del perfil. Todos opcionales: un perfil recien creado por
  /// el entrenador solo tiene nombre y correo, y su titular los completa despues.
  telefono        String?
  fechaNacimiento DateTime?
  fotoUrl         String?

  rol    Rol
  estado EstadoUsuario @default(pendiente)

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  tokensRefresco     TokenRefresco[]
  tokensActivacion   TokenActivacion[]
  tokensRecuperacion TokenRecuperacion[]

  /// Clientes que este usuario ve como nutricionista.
  clientesAsignados AsignacionNutricionista[] @relation("ComoNutricionista")

  /// Nutricionistas que ven a este usuario como cliente.
  nutricionistasAsignados AsignacionNutricionista[] @relation("ComoCliente")

  planesRecibidos     PlanEntrenamiento[] @relation("ClientePlan")
  planesCreados       PlanEntrenamiento[] @relation("CreadorPlan")
  sesionesProgramadas SesionProgramada[]
  cambiosDeFecha      CambioDeFecha[]
  rutinasGuardadas    RutinaGuardada[]

  dietas           Dieta[] @relation("DietasCliente")
  dietasCreadas    Dieta[] @relation("DietasCreadas")
  dietasPublicadas Dieta[] @relation("DietasPublicadas")

  molestias          Molestia[]       @relation("MolestiasCliente")
  molestiasAtendidas Molestia[]       @relation("MolestiasAtendidas")
  diasSeguimiento    DiaSeguimiento[]
  medidas            MedidaCorporal[] @relation("MedidasCliente")
  medidasTomadas     MedidaCorporal[] @relation("MedidasAutor")
  pruebas            PruebaFisica[]   @relation("PruebasCliente")
  pruebasTomadas     PruebaFisica[]   @relation("PruebasAutor")

  @@map("usuarios")
}

/// Token de refresco: la pieza que permite que el cliente no vuelva a escribir
/// su contrasena cada quince minutos.
///
/// Se guarda el hash, nunca el token. Quien robe una copia de la base de datos
/// no obtiene sesiones utilizables. Basta SHA-256 y no hace falta Argon2 porque
/// el secreto lo genera el servidor con 32 bytes aleatorios: no hay diccionario
/// que probar, y Argon2 solo serviria para hacer lento cada refresco legitimo.
model TokenRefresco {
  id String @id @default(uuid())

  usuarioId String
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  /// SHA-256 del secreto. El token que ve el cliente es "<id>.<secreto>".
  hash String

  /// Identifica la cadena entera de tokens nacida de un mismo login.
  ///
  /// Cada rotacion crea una fila nueva pero conserva esta familia. Sirve para
  /// dos cosas: cortar todas las sesiones derivadas de un login cuando se
  /// detecta que un token ya usado vuelve a aparecer, y aplicar una vida maxima
  /// a la cadena para que rotar no la alargue indefinidamente.
  familiaId       String
  familiaCreadaEn DateTime

  expiraEn   DateTime
  revocadoEn DateTime?
  creadoEn   DateTime  @default(now())

  /// Por que se revoco. No es documentacion: decide si un token que reaparece
  /// merece indulgencia. Una rotacion cuya respuesta se perdio si; un cierre de
  /// sesion o una expulsion, jamas.
  motivoRevocacion MotivoRevocacion?

  @@index([usuarioId])
  @@index([familiaId])
  @@map("tokens_refresco")
}

/// Que clientes puede ver cada nutricionista.
///
/// El nutricionista es un profesional EXTERNO subcontratado. Sin una fila aqui
/// no ve absolutamente nada de un cliente: ni su dieta, ni su peso, ni sus
/// medidas. El rol por si solo no basta, y esa es justo la frontera entre un
/// producto y un incidente de proteccion de datos.
model AsignacionNutricionista {
  id String @id @default(uuid())

  nutricionistaId String
  nutricionista   Usuario @relation("ComoNutricionista", fields: [nutricionistaId], references: [id], onDelete: Cascade)

  clienteId String
  cliente   Usuario @relation("ComoCliente", fields: [clienteId], references: [id], onDelete: Cascade)

  desde DateTime @default(now())

  /// Una asignacion por pareja. Asignar dos veces no crea dos filas.
  @@unique([nutricionistaId, clienteId])
  @@index([clienteId])
  @@map("asignaciones_nutricionista")
}

/// Enlace de un solo uso con el que un perfil pendiente fija su contrasena.
///
/// Mismo patron que el token de refresco: en la base solo vive el hash del
/// secreto, y lo que se envia por correo es "<id>.<secreto>". Un correo se queda
/// en servidores ajenos y en la papelera durante anos, asi que el enlace caduca
/// pronto y solo sirve una vez.
model TokenActivacion {
  id String @id @default(uuid())

  usuarioId String
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  hash String

  expiraEn DateTime
  usadoEn  DateTime?
  creadoEn DateTime  @default(now())

  @@index([usuarioId])
  @@map("tokens_activacion")
}

/// Recuperacion de una cuenta activa. Independiente de activacion: un enlace
/// de recuperacion nunca puede activar una cuenta pendiente o desactivada.
/// Solo se almacena SHA-256 del secreto aleatorio y caduca en una hora.
model TokenRecuperacion {
  id String @id @default(uuid())

  usuarioId String
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  hash     String
  expiraEn DateTime
  usadoEn  DateTime?
  creadoEn DateTime  @default(now())

  @@index([usuarioId])
  @@map("tokens_recuperacion")
}

/// Por que dejo de valer un token de refresco.
enum MotivoRevocacion {
  /// Se canjeo por otro. Es el caso normal y el unico que admite una ventana de
  /// gracia: si la respuesta no llego al movil, el cliente reintenta con el viejo.
  rotacion

  /// El usuario cerro sesion, o se expulsaron todas sus sesiones. Aqui no hay
  /// indulgencia posible: revivirlo convertiria el boton de cerrar sesion en una
  /// mentira.
  cierre

  /// Se detecto que un token ya gastado volvia a aparecer fuera de plazo.
  reuso

  /// Ya se uso su ventana de gracia. Marcarlo impide que varias peticiones
  /// simultaneas la usen todas y acaben bifurcando la sesion en varias cadenas,
  /// que es exactamente lo que la rotacion existe para impedir.
  reintento
}

/// Vocabulario compartido con packages/shared/src/catalogo-ejercicios.ts.
enum GrupoMuscular {
  pecho
  espalda
  hombros
  biceps
  triceps
  antebrazos
  abdomen
  gluteos
  cuadriceps
  isquiotibiales
  gemelos
}

enum EstadoEjercicio {
  publicado
  retirado
}

/// Catálogo global. La retirada conserva el ejercicio para su histórico.
model Ejercicio {
  id                String          @id @default(uuid())
  nombre            String          @db.VarChar(120)
  nombreNormalizado String          @unique
  grupoPrincipal    GrupoMuscular
  instrucciones     String          @db.VarChar(4000)
  /// «Cómo hacerlo» paso a paso, «evita» y consejos de la ficha de técnica (Design.html).
  pasos             Json            @default("[]")
  evita             String?         @db.VarChar(500)
  consejos          Json            @default("[]")
  estado            EstadoEjercicio @default(publicado)
  retiradoEn        DateTime?
  creadoEn          DateTime        @default(now())
  actualizadoEn     DateTime        @updatedAt

  gruposSecundarios GrupoSecundarioDeEjercicio[]
  referencias       ReferenciaEjercicio[]
  contenidos        ContenidoDeEjercicio[]

  @@index([estado, grupoPrincipal])
  @@map("ejercicios")
}

model GrupoSecundarioDeEjercicio {
  ejercicioId String
  grupo       GrupoMuscular
  ejercicio   Ejercicio     @relation(fields: [ejercicioId], references: [id], onDelete: Cascade)

  @@id([ejercicioId, grupo])
  @@index([grupo])
  @@map("grupos_secundarios_de_ejercicio")
}

enum EstadoSesionProgramada {
  abierta
  cerrada
}

model PlanEntrenamiento {
  id            String                @id @default(uuid())
  clienteId     String
  cliente       Usuario               @relation("ClientePlan", fields: [clienteId], references: [id], onDelete: Restrict)
  creadorId     String
  creador       Usuario               @relation("CreadorPlan", fields: [creadorId], references: [id], onDelete: Restrict)
  operacionId   String
  hashPeticion  String
  nombre        String                @db.VarChar(120)
  semanaInicial DateTime              @db.Date
  semanas       Int
  version       Int                   @default(1)
  patron        Json
  respuesta     Json
  /// Qué buscamos, fases, otros deportes y notas: lo que enseña «Bloque».
  bloque        Json?
  creadoEn      DateTime              @default(now())
  sesiones      SesionEntrenamiento[]

  @@unique([creadorId, operacionId])
  @@unique([id, clienteId])
  @@index([clienteId])
  @@map("planes_entrenamiento")
}

model SesionProgramada {
  id            String                 @id @default(uuid())
  clienteId     String
  cliente       Usuario                @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  fechaOriginal DateTime               @db.Date
  fechaActual   DateTime               @db.Date
  estado        EstadoSesionProgramada @default(abierta)
  revision      Int                    @default(0)
  entrenamiento SesionEntrenamiento?
  cambios       CambioDeFecha[]

  @@unique([id, clienteId])
  @@index([clienteId, fechaActual])
  @@map("sesiones_programadas")
}

model SesionEntrenamiento {
  id                   String                   @id
  clienteId            String
  agenda               SesionProgramada         @relation(fields: [id, clienteId], references: [id, clienteId], onDelete: Restrict)
  planId               String
  plan                 PlanEntrenamiento        @relation(fields: [planId, clienteId], references: [id, clienteId], onDelete: Restrict)
  version              Int                      @default(1)
  prescripcion         Json
  revisionPrescripcion Int                      @default(0)
  iniciada             Boolean                  @default(false)
  revisionBorrador     Int                      @default(0)
  borrador             Json?
  resultado            Json?
  enviadoEn            DateTime?
  referencias          ReferenciaEjercicio[]
  operaciones          OperacionEntrenamiento[]
  molestias            Molestia[]

  @@unique([id, clienteId])
  @@index([planId])
  @@map("sesiones_entrenamiento")
}

model ReferenciaEjercicio {
  sesionId    String
  idPrescrito String
  ejercicioId String
  sesion      SesionEntrenamiento @relation(fields: [sesionId], references: [id], onDelete: Restrict)
  ejercicio   Ejercicio           @relation(fields: [ejercicioId], references: [id], onDelete: Restrict)

  @@id([sesionId, idPrescrito])
  @@index([ejercicioId])
  @@map("referencias_ejercicio")
}

model CambioDeFecha {
  id            String           @id @default(uuid())
  sesionId      String
  sesion        SesionProgramada @relation(fields: [sesionId], references: [id], onDelete: Restrict)
  fechaAnterior DateTime         @db.Date
  fechaNueva    DateTime         @db.Date
  autorId       String
  autor         Usuario          @relation(fields: [autorId], references: [id], onDelete: Restrict)
  cambiadoEn    DateTime         @default(now())

  @@index([sesionId, cambiadoEn])
  @@map("cambios_de_fecha")
}

model RutinaGuardada {
  id            String   @id @default(uuid())
  nombre        String   @db.VarChar(120)
  creadorId     String
  creador       Usuario  @relation(fields: [creadorId], references: [id], onDelete: Restrict)
  version       Int      @default(1)
  patron        Json
  revision      Int      @default(0)
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@index([creadorId])
  @@map("rutinas_guardadas")
}

/// Registro de operaciones confirmado en la misma transacción que la escritura.
model OperacionEntrenamiento {
  sesionId     String
  sesion       SesionEntrenamiento @relation(fields: [sesionId], references: [id], onDelete: Restrict)
  operacionId  String
  tipo         String
  version      Int                 @default(1)
  hashPeticion String
  respuesta    Json
  creadoEn     DateTime            @default(now())

  @@id([sesionId, operacionId])
  @@map("operaciones_entrenamiento")
}

enum EstadoDieta {
  borrador
  publicada
  archivada
}

/// Dieta de un cliente (SPEC-nutricion.md). El documento completo va en JSON,
/// validado con Zod en cada escritura y lectura, como la prescripción.
///
/// Un cliente tiene como mucho un borrador y una publicada: lo garantizan dos
/// índices únicos parciales escritos en la migración, porque Prisma no los
/// expresa en el esquema. Una publicada o archivada no se modifica nunca.
model Dieta {
  id                   String      @id @default(uuid())
  clienteId            String
  cliente              Usuario     @relation("DietasCliente", fields: [clienteId], references: [id], onDelete: Restrict)
  estado               EstadoDieta
  /// Versión del formato del documento, para poder migrarlo sin reescribir filas.
  version              Int         @default(1)
  documento            Json
  revision             Int         @default(0)
  /// Idempotencia de la publicación: el mismo id devuelve el mismo resultado.
  operacionPublicacion String?
  hashPublicacion      String?
  creadaPorId          String
  creadaPor            Usuario     @relation("DietasCreadas", fields: [creadaPorId], references: [id], onDelete: Restrict)
  publicadaPorId       String?
  publicadaPor         Usuario?    @relation("DietasPublicadas", fields: [publicadaPorId], references: [id], onDelete: Restrict)
  creadaEn             DateTime    @default(now())
  actualizadaEn        DateTime    @updatedAt
  publicadaEn          DateTime?
  archivadaEn          DateTime?

  @@unique([clienteId, operacionPublicacion])
  @@index([clienteId, estado])
  @@map("dietas")
}

enum TipoDeContenido {
  figura
  video
}

enum OrigenDeContenido {
  propio
  licenciado
  provisional
}

/// Figura o vídeo de un ejercicio (SPEC-catalogo-ejercicios.md). La clave apunta
/// al índice de medios del servidor y nunca sale en una respuesta. Un ejercicio
/// tiene como mucho una figura y un vídeo. Ninguna columna apunta a un usuario.
model ContenidoDeEjercicio {
  id            String            @id @default(uuid())
  ejercicioId   String
  ejercicio     Ejercicio         @relation(fields: [ejercicioId], references: [id], onDelete: Restrict)
  tipo          TipoDeContenido
  claveDeObjeto String            @db.VarChar(120)
  origen        OrigenDeContenido
  licencia      String?           @db.VarChar(200)
  atribucion    String?           @db.VarChar(200)
  subidoEn      DateTime          @default(now())

  @@unique([ejercicioId, tipo])
  @@map("contenidos_de_ejercicio")
}

enum ZonaDeMolestia {
  hombro
  codo
  muneca
  lumbar
  otra
}

enum EstadoMolestia {
  abierta
  atendida
}

/// Molestia avisada durante un entrenamiento (Design.html). La intensidad va de
/// 0 a 10 (CHECK en la migración). El nombre del ejercicio se copia al avisar:
/// la prescripción puede cambiar después y el aviso tiene que seguir diciendo lo mismo.
model Molestia {
  id                   String              @id @default(uuid())
  clienteId            String
  cliente              Usuario             @relation("MolestiasCliente", fields: [clienteId], references: [id], onDelete: Restrict)
  sesionId             String
  sesion               SesionEntrenamiento @relation(fields: [sesionId, clienteId], references: [id, clienteId], onDelete: Restrict)
  operacionId          String
  ejercicioPrescritoId String?
  ejercicio            String?             @db.VarChar(120)
  serie                Int?
  zona                 ZonaDeMolestia
  intensidad           Int
  sintomas             String[]
  nota                 String?             @db.VarChar(1000)
  estado               EstadoMolestia      @default(abierta)
  respuesta            String?             @db.VarChar(1000)
  atendidaPorId        String?
  atendidaPor          Usuario?            @relation("MolestiasAtendidas", fields: [atendidaPorId], references: [id], onDelete: Restrict)
  atendidaEn           DateTime?
  creadaEn             DateTime            @default(now())

  @@unique([clienteId, operacionId])
  @@index([clienteId, estado, creadaEn])
  @@map("molestias")
}

/// Registro diario del cliente: peso en ayunas, pasos, sueño y creatina.
model DiaSeguimiento {
  clienteId     String
  cliente       Usuario  @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  fecha         DateTime @db.Date
  pesoKg        Decimal? @db.Decimal(4, 1)
  pasos         Int?
  suenoMin      Int?
  creatina      Boolean?
  actualizadoEn DateTime @updatedAt

  @@id([clienteId, fecha])
  @@map("dias_seguimiento")
}

/// Medidas corporales: las toma el cliente o su equipo.
model MedidaCorporal {
  id          String   @id @default(uuid())
  clienteId   String
  cliente     Usuario  @relation("MedidasCliente", fields: [clienteId], references: [id], onDelete: Restrict)
  autorId     String
  autor       Usuario  @relation("MedidasAutor", fields: [autorId], references: [id], onDelete: Restrict)
  operacionId String
  fecha       DateTime @db.Date
  pesoKg      Decimal? @db.Decimal(4, 1)
  cinturaCm   Decimal? @db.Decimal(4, 1)
  grasaPct    Decimal? @db.Decimal(3, 1)
  alturaCm    Int?
  creadoEn    DateTime @default(now())

  @@unique([autorId, operacionId])
  @@index([clienteId, fecha])
  @@map("medidas_corporales")
}

/// Pruebas físicas: «Flexiones seguidas · 32 reps».
model PruebaFisica {
  id          String   @id @default(uuid())
  clienteId   String
  cliente     Usuario  @relation("PruebasCliente", fields: [clienteId], references: [id], onDelete: Restrict)
  autorId     String
  autor       Usuario  @relation("PruebasAutor", fields: [autorId], references: [id], onDelete: Restrict)
  operacionId String
  fecha       DateTime @db.Date
  nombre      String   @db.VarChar(60)
  valor       Decimal  @db.Decimal(8, 2)
  unidad      String   @db.VarChar(12)
  creadoEn    DateTime @default(now())

  @@unique([autorId, operacionId])
  @@index([clienteId, nombre, fecha])
  @@map("pruebas_fisicas")
}

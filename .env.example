# Plantilla. Copia este fichero a .env y pon tus valores.
# .env esta ignorado por git y no se sube nunca.
#
#   cp .env.example .env

POSTGRES_USER=alpha
POSTGRES_PASSWORD=pon_aqui_una_contrasena
POSTGRES_DB=alpha_omega

# Cadena de conexion que usa Prisma. La contrasena debe coincidir con la de arriba.
DATABASE_URL=postgresql://alpha:pon_aqui_una_contrasena@localhost:5432/alpha_omega?schema=public

# Plantilla. Copia este fichero a .env y pon tus valores.
# .env esta ignorado por git y no se sube nunca.
#
#   cp .env.example .env

POSTGRES_USER=alpha
POSTGRES_PASSWORD=pon_aqui_una_contrasena
POSTGRES_DB=alpha_omega

# Opcionales. Solo hacen falta si la base no corre en tu propia maquina.
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# No hay DATABASE_URL a proposito. La compone prisma.config.ts a partir de las
# variables de arriba, para que la contrasena este escrita en un solo sitio.

# Secreto para firmar los tokens de sesion. Generalo con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=genera_uno_largo_y_aleatorio
JWT_EXPIRACION_ACCESO_SEGUNDOS=900

# Cuenta inicial del entrenador que crea el seed.
SEED_ENTRENADOR_EMAIL=entrenador@alphayomegatraining.com
SEED_ENTRENADOR_PASSWORD=pon_aqui_una_contrasena
